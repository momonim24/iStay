# Copy to .env.local, then obtain these public values from Supabase > Connect.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback when no publishable key is set:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Never use a service_role key, sb_secret_ key, or Google client secret here.
